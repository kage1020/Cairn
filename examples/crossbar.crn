@cairn 2026.06
@requires version>=1.20

# An escape fixture: two pressure plates feed both gates, whose output
# signals fan out to two doors at opposite ends of the region. Four
# nets over a region this size cannot all take their shortest route.
# Two of them would want one coord, and dust reads the dust beside it,
# so two more would want to run in adjacent rows — either way that is
# one strand carrying two signals.
#
# So the routing pass lays each net around the dust of the ones before
# it and around the coords beside that dust, and a net with nowhere to
# go round climbs to a bridge layer inside the `void=` budget. What the
# wire form below shows is that escape: a strand that leaves the ground
# layer not to clear a block but to clear another signal.
#
# `void=2` and not `void=1` for the same reason. With no layer above
# the plane the last net has nowhere left at all, and the compiler
# refuses the scope rather than shorting it — which is the other half
# of the same rule, and is what the second layer buys here. The region
# is wider and deeper than the row strictly needs, so it is the `void`
# that decides.
#
# Kept intentionally minimal so the wire form pinned by the redstone
# crate's byte-identity crossing integration test reads at a glance.

theme cross:
  slot wall -> @oak_planks
  slot door -> @oak_door

struct crossbar size=6x4
  floor mat_slot=wall
  walls class=outer mat_slot=wall height=3
  door  id=front side=front at=center mat_slot=door
  door  id=back  side=back  at=center mat_slot=door

  pressure_plate id=plate1 at=front.outside offset=0 y=0 -> sig.a
  pressure_plate id=plate2 at=inside.front  offset=0 y=0 -> sig.b

  logic sig.f1 = sig.a and sig.b
  logic sig.f2 = sig.a or sig.b

  door[id=front] opened_by=sig.f1
  door[id=back]  opened_by=sig.f2

  circuit region=floor void=2
