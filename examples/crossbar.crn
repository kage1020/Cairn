@cairn 2026.06
@requires version>=1.20

# Two pressure plates feed both gates, whose outputs drive two doors at
# opposite ends of the struct. Each plate's signal runs to both gates and
# each gate's to a door across the floor, so two wires must cross.
#
# Dust beside dust joins it, so a crossing runs one wire over the other a
# layer up, on a block that keeps the two apart. That takes a layer above
# the cells' and one under the floor: `void=4`. With `void=3` the wires
# can only go round each other, and where they cannot the compiler
# refuses the scope rather than shorting two signals.

theme cross:
  slot wall -> @oak_planks

struct crossbar size=12x10
  floor mat_slot=wall
  walls class=outer mat_slot=wall height=3
  roof  kind=flat mat_slot=wall overhang=1
  door  id=front side=front at=center
  door  id=back  side=back  at=center

  pressure_plate id=plate1 at=front.outside offset=0 y=0 -> sig.a
  pressure_plate id=plate2 at=inside.front  offset=1 y=0 -> sig.b

  logic sig.f1 = sig.a and sig.b
  logic sig.f2 = sig.a or sig.b

  door[id=front] opened_by=sig.f1
  door[id=back]  opened_by=sig.f2

  circuit region=floor void=4
