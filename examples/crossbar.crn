@cairn 2026.06
@requires version>=1.20

# A crossing fixture: two pressure plates feed both gates, whose
# output signals fan out to two doors at opposite ends of the region.
# Two pairs of nets end up sharing a wire coord — `sig.a` with `sig.b`
# at (1,0,1), and `sig.b` with the first gate at (0,1,0). The second of
# those is on a bridge layer, where two nets that each climbed to clear
# a block met, so a crossing is not a plane-only event.
#
# The crossing pass reports both and repairs neither: it lifts a buffer
# repeater off a coord it cannot have and never the wire itself, so
# those signals are one strand of dust in whatever layout these coords
# describe.
#
# Kept intentionally minimal so the wire form pinned by the redstone
# crate's byte-identity crossing integration test reads at a glance.

theme cross:
  slot wall -> @oak_planks
  slot door -> @oak_door

struct crossbar size=5x4
  floor mat_slot=wall
  walls class=outer mat_slot=wall height=3
  door  id=front side=front at=center mat_slot=door
  door  id=back  side=back  at=center mat_slot=door

  pressure_plate id=plate1 at=front.outside offset=0 y=0 -> sig.a
  pressure_plate id=plate2 at=inside.front  offset=0 y=0 -> sig.b

  logic sig.f1 = sig.a and sig.b
  logic sig.f2 = sig.a or sig.b

  door[id=front] opened_by=sig.f1
  door[id=back]  opened_by=sig.f2

  circuit region=floor void=2
