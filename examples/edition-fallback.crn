@cairn 2026.06
@requires version>=1.20
@requires bedrock version>=1.21.40

# Per-edition theme fallback (spec/versioning-editions "Java / Bedrock
# portability", hierarchy #2).
#
# The `floating_text` slot has no cross-edition primitive: Java's
# `text_display` is an entity (added 1.19.4), and Bedrock has no equivalent
# display entity at all. Both editions can carry a plain sign though, so
# the logical theme `shop` splits into `shop_java` (resolving the slot to
# a standing oak sign) and `shop_bedrock` (resolving it to a wall-mounted
# oak sign). The semantic layer — `mat_slot=floating_text` on the window
# member — is edition-neutral and never touches `@edition`, which that
# section forbids outside the escape-hatch layer.
#
# `cairn compile --edition java` picks `shop_java`; `--edition bedrock`
# picks `shop_bedrock`. `cairn check` (no `--edition`) unions the slot
# names across both variants so `mat_slot=floating_text` resolves without
# emitting `E_UNRESOLVED_SLOT` under either variant's presence.
#
# The lamp is the escape hatch (hierarchy #3). Java spells the light block
# `minecraft:light[level=15]` and Bedrock `minecraft:light_block_15`, so
# each spelling stands under its own edition's `@edition` guard, and a build
# keeps only the guard of the edition it pins. Bedrock first spells the
# block that way in 1.21.40, which the scoped floor above declares.

theme shop_java:
  slot floor          -> @floor.stone.smooth
  slot wall           -> @wall.stone.cobble
  slot floating_text  -> @sign.oak

theme shop_bedrock:
  slot floor          -> @floor.stone.smooth
  slot wall           -> @wall.stone.cobble
  slot floating_text  -> @sign.oak_wall

# The display window sits on the course above the door's opening, not in
# it: `door at=center` and `offset=2` share the front wall's middle column
# and `door` cuts `y = 1..=2`, so `y=2` put the sign inside the doorway.
# Both are openings, so nothing but the line order decided which of them
# the cell kept (`W_PHASE_CONFLICT`).

struct shop size=5x5
  floor  mat_slot=floor
  walls  class=outer mat_slot=wall height=3
  door   side=front at=center
  window class=display side=front offset=2 y=3 size=1x1 mat_slot=floating_text
  @edition java
    raw_block mat=minecraft:light[level=15] at=2,2,2
  @edition bedrock
    raw_block mat=minecraft:light_block_15 at=2,2,2
