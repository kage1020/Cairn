{
  "name": "cairn-lang",
  "displayName": "Cairn",
  "description": "Language support for Cairn (.crn) — a Minecraft build description language.",
  "version": "2026.7.2",
  "publisher": "kage1020",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/kage1020/Cairn.git",
    "directory": "editors/vscode"
  },
  "homepage": "https://github.com/kage1020/Cairn",
  "bugs": {
    "url": "https://github.com/kage1020/Cairn/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Programming Languages"],
  "keywords": ["cairn", "minecraft", "lsp", "language-server"],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:cairn",
    "workspaceContains:**/*.crn"
  ],
  "contributes": {
    "languages": [
      {
        "id": "cairn",
        "aliases": ["Cairn", "cairn"],
        "extensions": [".crn"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "cairn",
        "scopeName": "source.cairn",
        "path": "./syntaxes/cairn.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Cairn",
      "properties": {
        "cairn.serverPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Absolute path to the `cairn-lsp` binary. Leave empty to look up `cairn-lsp` on `PATH`. Install the binary from the [GitHub release](https://github.com/kage1020/Cairn/releases) matching your `cairn` CLI version."
        },
        "cairn.trace.server": {
          "type": "string",
          "enum": ["off", "messages", "verbose"],
          "default": "off",
          "description": "Trace communication between VS Code and the Cairn language server in the Output panel."
        }
      }
    }
  },
  "scripts": {
    "build": "tsc -p .",
    "watch": "tsc -p . --watch",
    "package": "vsce package --no-dependencies"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.2.1",
    "typescript": "^5.6.3"
  }
}
