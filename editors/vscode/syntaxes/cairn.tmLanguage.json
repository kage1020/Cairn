{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Cairn",
  "scopeName": "source.cairn",
  "patterns": [
    { "include": "#comment" },
    { "include": "#directive" },
    { "include": "#edition-guard" },
    { "include": "#top-level" },
    { "include": "#slot-binding" },
    { "include": "#member-keyword" },
    { "include": "#string" },
    { "include": "#material-token" },
    { "include": "#block-id" },
    { "include": "#nbt" },
    { "include": "#attribute-key" },
    { "include": "#arrow" },
    { "include": "#coordinate" },
    { "include": "#number" }
  ],
  "repository": {
    "comment": {
      "name": "comment.line.number-sign.cairn",
      "match": "#.*$"
    },
    "directive": {
      "name": "meta.directive.cairn",
      "match": "^\\s*(@cairn|@requires|@intended_targets)\\b",
      "captures": {
        "1": { "name": "keyword.control.directive.cairn" }
      }
    },
    "edition-guard": {
      "name": "meta.edition-guard.cairn",
      "match": "^\\s*(@edition)\\b(?:\\s+(java|bedrock)\\b)?",
      "captures": {
        "1": { "name": "keyword.control.directive.cairn" },
        "2": { "name": "constant.language.edition.cairn" }
      }
    },
    "top-level": {
      "match": "^\\s*(theme|def|site|struct)\\b",
      "captures": {
        "1": { "name": "keyword.other.top-level.cairn" }
      }
    },
    "slot-binding": {
      "match": "^\\s*(slot)\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": { "name": "keyword.other.slot.cairn" },
        "2": { "name": "variable.other.slot-name.cairn" }
      }
    },
    "member-keyword": {
      "match": "^\\s*(floor|walls|fill|door|window|roof|stair|level|pressure_plate|lever|button|daylight|observer|lamp|piston|dispenser|chest|repeater|comparator|redstone_torch|redstone_dust|circuit|raw_block|raw_fill|place|connect)\\b",
      "captures": {
        "1": { "name": "keyword.other.member.cairn" }
      }
    },
    "string": {
      "name": "string.quoted.double.cairn",
      "begin": "\"",
      "end": "\"|$",
      "patterns": []
    },
    "material-token": {
      "name": "entity.name.type.material.cairn",
      "match": "@[A-Za-z_][A-Za-z0-9_\\.]*"
    },
    "block-id": {
      "name": "entity.name.type.block-id.cairn",
      "match": "(?<==)[A-Za-z_][A-Za-z0-9_]*:[A-Za-z_][A-Za-z0-9_]*"
    },
    "nbt": {
      "name": "meta.nbt.cairn",
      "begin": "(?<==)\\s*(\\{)",
      "beginCaptures": {
        "1": { "name": "punctuation.section.braces.begin.cairn" }
      },
      "end": "\\}|$",
      "endCaptures": {
        "0": { "name": "punctuation.section.braces.end.cairn" }
      },
      "patterns": [{ "include": "#nbt-contents" }]
    },
    "nbt-contents": {
      "patterns": [
        {
          "begin": "\\{",
          "end": "\\}|$",
          "patterns": [{ "include": "#nbt-contents" }]
        },
        {
          "name": "string.quoted.double.cairn",
          "match": "\"(?:[^\"\\\\]|\\\\[\"\\\\])*\""
        },
        {
          "name": "string.quoted.single.cairn",
          "match": "'(?:[^'\\\\]|\\\\['\\\\])*'"
        },
        {
          "name": "variable.other.property.cairn",
          "match": "[A-Za-z0-9_.+-]+(?=\\s*:)"
        },
        {
          "name": "storage.type.array.cairn",
          "match": "(?<=\\[)[BIL];"
        },
        {
          "name": "constant.language.boolean.cairn",
          "match": "\\b(?:true|false)\\b"
        },
        {
          "name": "constant.numeric.cairn",
          "match": "[+-]?\\b\\d+(?:\\.\\d+)?[bBsSlLfFdD]?\\b"
        }
      ]
    },
    "attribute-key": {
      "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(=)",
      "captures": {
        "1": { "name": "variable.parameter.attribute.cairn" },
        "2": { "name": "keyword.operator.assignment.cairn" }
      }
    },
    "arrow": {
      "name": "keyword.operator.arrow.cairn",
      "match": "->"
    },
    "coordinate": {
      "name": "constant.numeric.coordinate.cairn",
      "match": "(?<==)\\d+,\\d+,\\d+\\b(?!,\\d)"
    },
    "number": {
      "name": "constant.numeric.cairn",
      "match": "\\b\\d+(?:\\.\\d+|x\\d+)?\\b"
    }
  }
}
